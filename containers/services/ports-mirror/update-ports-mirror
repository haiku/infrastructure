from datetime import datetime
import glob
import hashlib
import json
import os
import re
import ssl
import sys
import time
import urllib.error
import urllib.request
from subprocess import check_call, check_output

def log(level, message, **fields):
	record = {
		'timestamp': datetime.now().strftime('%Y-%m-%dT%H:%M:%S'),
		'level': level,
		'message': message,
	}
	record.update(fields)
	print(json.dumps(record), flush=True)

# constants
gitRepos = [
	['/ports-mirror/haikuports.git', 'https://github.com/haikuports/haikuports'],
	['/ports-mirror/haikuports.cross.git', 'https://github.com/haikuports/haikuports.cross'],
]

downloadDir = '/tmp/ports-mirror.in'
maxSourceSizeBytes = 250 * 1024 * 1024 # skip archiving source packages larger than maxSourceSizeBytes

# Source packages are archived to an S3 bucket in a <recipeName>/<filename>
# layout, keyed by the recipe name and the source filename.
s3Bucket = os.environ.get('S3_BUCKET')
s3Endpoint = os.environ.get('S3_ENDPOINT')
s3Region = os.environ.get('S3_REGION')
s3AccessKey = os.environ.get('S3_ACCESS_KEY')
s3SecretKey = os.environ.get('S3_SECRET_KEY')

if not (s3Bucket and s3Endpoint and s3Region and s3AccessKey and s3SecretKey):
	log('error', 'S3_BUCKET, S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY, and S3_SECRET_KEY are required!')
	sys.exit(1)

import boto3
from botocore.client import Config
from botocore.exceptions import ClientError

s3Client = boto3.client(
	's3',
	endpoint_url=s3Endpoint,
	region_name=s3Region,
	aws_access_key_id=s3AccessKey,
	aws_secret_access_key=s3SecretKey,
	config=Config(signature_version='s3v4'),
)

if not os.path.exists(downloadDir):
	os.mkdir(downloadDir)

shellVars = dict()
recipe = ''

def globToRegex(glob, greedy):
	# Translate a bash glob pattern into a regular expression.  Bash escapes
	# like "\~" are turned into the literal escaped character, while "*" and
	# "?" become the equivalent regex quantifiers.
	out = []
	i = 0
	while i < len(glob):
		c = glob[i]
		if c == '\\' and i + 1 < len(glob):
			out.append(re.escape(glob[i + 1]))
			i += 2
			continue
		if c == '*':
			out.append('.*' if greedy else '.*?')
		elif c == '?':
			out.append('.')
		else:
			out.append(re.escape(c))
		i += 1
	return ''.join(out)

def resolveVar(name, recipe, depth=0):
	if name in shellVars:
		return shellVars[name]
	if depth > 20:
		return None
	lineMatch = re.search('^' + name + r'=(.*)$', recipe, flags=re.MULTILINE)
	if not lineMatch:
		return None
	value = lineMatch.group(1)
	value = value.split(' #', 1)[0].strip()
	if value.startswith('"'):
		# strip the enclosing quotes; the value may itself contain quotes
		# (e.g. inside a `...` command substitution), so use the last quote
		endQuote = value.rfind('"')
		if endQuote > 0:
			value = value[1:endQuote]
		else:
			value = value[1:]
	value = expandVariables(value, recipe, depth + 1)
	shellVars[name] = value
	return value

def expandParameter(expr, recipe, depth):
	# Expands a bash-style ${...} parameter expansion, supporting the forms
	# used by haikuports recipes: ${var}, ${var:offset:length}, ${var#pat} /
	# ${var##pat}, ${var%pat} / ${var%%pat}, and ${var/pat[/repl]} /
	# ${var//pat[/repl]}.
	m = re.match(r'^(\w+)(.*)$', expr)
	if not m:
		return '${' + expr + '}'
	name = m.group(1)
	op = m.group(2)
	value = resolveVar(name, recipe, depth)
	if value is None:
		return '${' + expr + '}'
	if op == '':
		return value
	if op.startswith(':?'):
		# ${var:?} expands to the value, erroring only if unset
		return value
	substringMatch = re.match(r'^:(-?\d+)(?::(-?\d+))?$', op)
	if substringMatch:
		offset = int(substringMatch.group(1))
		length = int(substringMatch.group(2)) if substringMatch.group(2) is not None else None
		return value[offset:] if length is None else value[offset:offset + length]
	prefixMatch = re.match(r'^(##?)(.+)$', op)
	if prefixMatch:
		glob = prefixMatch.group(2)
		greedy = prefixMatch.group(1) == '##'
		prefixRemoved = re.match('^(' + globToRegex(glob, greedy) + ')(.*)$', value)
		if prefixRemoved:
			return prefixRemoved.group(2)
		return value
	suffixMatch = re.match(r'^(%%?)(.+)$', op)
	if suffixMatch:
		glob = suffixMatch.group(2)
		if suffixMatch.group(1) == '%%':
			# remove the longest suffix, keep the shortest prefix
			suffixRemoved = re.match('^(.*?)' + globToRegex(glob, True) + '$', value)
		else:
			# remove the shortest suffix, keep the longest prefix
			suffixRemoved = re.match('^(.*)' + globToRegex(glob, True) + '$', value)
		if suffixRemoved:
			return suffixRemoved.group(1)
		return value
	replaceMatch = re.match(r'^(//?)(.*)$', op, flags=re.DOTALL)
	if replaceMatch:
		allOccurrences = replaceMatch.group(1) == '//'
		rest = replaceMatch.group(2)
		if '/' in rest:
			pattern, replacement = rest.split('/', 1)
		else:
			pattern, replacement = rest, ''
		count = 0 if allOccurrences else 1
		return re.sub(globToRegex(pattern, True), lambda match: replacement, value, count=count)
	return '${' + expr + '}'

def findCommandClose(string, start, openChar, closeChar):
	# Returns the index of the closeChar matching the openChar opened at
	# 'start', skipping backslash-escaped characters (e.g. the "\)" in a sed
	# expression), or -1 when unbalanced.
	depth = 1
	i = start
	while i < len(string):
		if string[i] == '\\' and i + 1 < len(string):
			i += 2
			continue
		if string[i] == openChar:
			depth += 1
		elif string[i] == closeChar:
			depth -= 1
			if depth == 0:
				return i
		i += 1
	return -1

def expandVariables(string, recipe, depth=0):
	out = []
	i = 0
	n = len(string)
	while i < n:
		c = string[i]
		if c == '$' and i + 1 < n:
			nextChar = string[i + 1]
			if nextChar == '{':
				close = string.find('}', i + 2)
				if close != -1:
					out.append(expandParameter(string[i + 2:close], recipe, depth))
					i = close + 1
					continue
			elif nextChar == '(':
				close = findCommandClose(string, i + 2, '(', ')')
				if close != -1:
					result = evaluateCommand(string[i + 2:close], recipe, depth)
					out.append(result if result is not None else string[i:close + 1])
					i = close + 1
					continue
			else:
				nameMatch = re.match(r'\w+', string[i + 1:])
				if nameMatch:
					name = nameMatch.group(0)
					value = resolveVar(name, recipe, depth)
					out.append(value if value is not None else '$' + name)
					i += 1 + len(name)
					continue
			out.append(c)
			i += 1
			continue
		elif c == '`':
			close = string.find('`', i + 1)
			if close != -1:
				result = evaluateCommand(string[i + 1:close], recipe, depth)
				out.append(result if result is not None else string[i:close + 1])
				i = close + 1
				continue
			out.append(c)
			i += 1
			continue
		out.append(c)
		i += 1
	return ''.join(out)

def sedPatternToRegex(pattern):
	# Translates a sed basic regular expression into a python regular
	# expression, handling the constructs used by haikuports recipes (e.g.
	# "\." for a literal dot, "\(...\)" groups, and "\>" for end-of-word).
	out = []
	i = 0
	while i < len(pattern):
		c = pattern[i]
		if c == '\\' and i + 1 < len(pattern):
			nxt = pattern[i + 1]
			if nxt == '>':
				out.append(r'(?=\W|$)')
			elif nxt == '<':
				out.append(r'(?<=\W)')
			elif nxt == '(':
				out.append('(')
			elif nxt == ')':
				out.append(')')
			elif nxt in '0123456789':
				out.append('\\' + nxt)
			elif nxt == '.':
				out.append(r'\.')
			else:
				out.append(re.escape(nxt))
			i += 2
		elif c == '[':
			j = i
			while j < len(pattern) and pattern[j] != ']':
				j += 1
			out.append(pattern[i:j + 1])
			i = j + 1
		else:
			out.append(re.escape(c))
			i += 1
	return ''.join(out)

def applySedExpr(value, expr):
	if not expr.startswith('s'):
		return value
	delim = expr[1] if len(expr) > 1 else '/'
	parts = expr[2:].split(delim)
	if len(parts) < 2:
		return value
	pattern = parts[0]
	replacement = parts[1]
	flags = parts[2] if len(parts) > 2 else ''
	count = 0 if 'g' in flags else 1
	return re.sub(sedPatternToRegex(pattern), replacement, value, count=count)

def applySed(value, sedArgs):
	result = value
	exprs = []
	i = 0
	while i < len(sedArgs):
		arg = sedArgs[i].strip().strip("'").strip('"')
		if arg == '-e' and i + 1 < len(sedArgs):
			exprs.append(sedArgs[i + 1].strip().strip("'").strip('"'))
			i += 2
		elif arg.startswith('-e'):
			exprs.append(arg[2:].strip())
			i += 1
		elif arg.startswith('s'):
			exprs.append(arg)
			i += 1
		else:
			i += 1
	for expr in exprs:
		result = applySedExpr(result, expr)
	return result

def applyCut(value, cutArgs):
	delim = None
	fieldSpec = None
	rangeSpec = None
	i = 0
	while i < len(cutArgs):
		arg = cutArgs[i]
		if arg in ('-d', '--delimiter') and i + 1 < len(cutArgs):
			delim = cutArgs[i + 1]
			i += 2
		elif arg.startswith('-d') and len(arg) > 2:
			delim = arg[2:]
			i += 1
		elif arg == '-f' and i + 1 < len(cutArgs):
			fieldSpec = cutArgs[i + 1]
			i += 2
		elif arg.startswith('-f') and len(arg) > 2:
			fieldSpec = arg[2:]
			i += 1
		elif arg.startswith('-b') or arg.startswith('-c'):
			if len(arg) > 2:
				rangeSpec = arg[2:]
				i += 1
			elif i + 1 < len(cutArgs):
				rangeSpec = cutArgs[i + 1]
				i += 2
			else:
				i += 1
		else:
			i += 1
	if rangeSpec is not None:
		low, _, high = rangeSpec.partition('-')
		low = int(low) if low else 0
		high = int(high) if high else None
		return value[low - 1:high]
	if delim is None or fieldSpec is None:
		return value
	pieces = value.split(delim)
	out = []
	for spec in fieldSpec.split(','):
		if '-' in spec:
			low, high = spec.split('-', 1)
			low = int(low) if low else 1
			high = int(high) if high else len(pieces)
			out.extend(pieces[low - 1:high])
		else:
			index = int(spec)
			if 1 <= index <= len(pieces):
				out.append(pieces[index - 1])
	return delim.join(out)

def evaluateCommand(command, recipe, depth):
	# Evaluates the simple shell pipelines used by haikuports recipes to
	# transform versions, e.g. `echo $portVersion | sed 's/\_/-/g'` or
	# $(echo $portVersion | cut -d. -f1).  Returns None when the command
	# cannot be evaluated so the original substitution is preserved.
	command = expandVariables(command, recipe, depth + 1)
	stages = [stage.strip() for stage in command.split('|')]
	if not stages or not stages[0].startswith('echo'):
		return None
	value = None
	for stage in stages:
		parts = stage.split()
		if not parts:
			continue
		if parts[0] == 'echo':
			value = ' '.join(parts[1:]).strip().strip('"').strip("'")
		elif parts[0] == 'sed' and value is not None:
			value = applySed(value, parts[1:])
		elif parts[0] == 'cut' and value is not None:
			value = applyCut(value, parts[1:])
		elif parts[0] == 'basename' and value is None:
			value = os.path.basename(' '.join(parts[1:]).strip().strip('"').strip("'"))
		elif parts[0] == 'dirname' and value is None:
			value = os.path.dirname(' '.join(parts[1:]).strip().strip('"').strip("'"))
	return value

def stripFragment(spec):
	# haikuports appends URL fragments like "#noarchive" to SOURCE_URI.  Only
	# strip a "#" that ends the URL; a "#" inside a bash parameter expansion
	# (e.g. ${portVersion##*.}) is always followed by "}" and must be kept so
	# it is not confused with a URL fragment.
	hashIndex = spec.rfind('#')
	if hashIndex != -1 and '}' not in spec[hashIndex:]:
		return spec[:hashIndex]
	return spec

def s3ObjectValid(s3target, expectedSha256):
	# Returns True when the object exists in the bucket and the sha256 checksum
	# recorded on it matches the one described in the recipe.  Objects that are
	# missing, that predate checksum recording, or whose checksum does not match
	# are considered invalid so they get re-downloaded and re-archived.
	try:
		head = s3Client.head_object(Bucket=s3Bucket, Key=s3target)
	except ClientError as e:
		if e.response['Error']['Code'] == '404':
			return False
		raise
	return head.get('Metadata', {}).get('sha256') == expectedSha256

def isHttpHtmlResponse(path):
	# Returns True when the downloaded content looks like an HTML response
	# (e.g. a 200-OK error page) rather than the expected binary source file.
	try:
		with open(path, 'rb') as f:
			head = f.read(2048)
	except Exception:
		return False
	low = head.lstrip().lower()
	return (low.startswith(b'<!doctype html') or low.startswith(b'<html')
		or b'<!doctype html' in low or b'<html>' in low or b'<title>' in low)

def getRemoteFileSize(url):
	# Returns the Content-Length reported by the server via a HEAD request, or
	# None when the size cannot be determined up front (e.g. servers that do
	# not support HEAD).
	sslContext = ssl._create_unverified_context()
	request = urllib.request.Request(url, method='HEAD', headers={ 'User-Agent': 'haiku-ports-mirror/1.0' })
	try:
		response = urllib.request.urlopen(request, context=sslContext, timeout=60)
	except Exception:
		return None
	size = response.headers.get('Content-Length')
	response.close()
	if size is None:
		return None
	try:
		return int(size)
	except ValueError:
		return None

def downloadFile(url, targetPath, rateLimitBytes):
	# Downloads url to targetPath using the standard library, following
	# redirects and tolerating self-signed TLS certificates (mirroring the
	# previous "curl -kL" behaviour).  The sha256 of the content is computed
	# while streaming and returned along with the HTTP status and Content-Type
	# so callers can reject HTML error pages.
	sslContext = ssl._create_unverified_context()
	request = urllib.request.Request(url, headers={ 'User-Agent': 'haiku-ports-mirror/1.0' })
	try:
		response = urllib.request.urlopen(request, context=sslContext, timeout=120)
	except urllib.error.HTTPError as e:
		return {
			'success': False,
			'error': str(e),
			'status': e.code,
			'content_type': e.headers.get('Content-Type', ''),
			'sha256': None,
		}
	except Exception as e:
		return {
			'success': False,
			'error': str(e),
			'status': None,
			'content_type': '',
			'sha256': None,
		}

	status = getattr(response, 'status', getattr(response, 'code', 200))
	contentType = response.headers.get('Content-Type', '') or ''
	hasher = hashlib.sha256()
	with open(targetPath, 'wb') as f:
		while True:
			chunk = response.read(64 * 1024)
			if not chunk:
				break
			hasher.update(chunk)
			f.write(chunk)
			time.sleep(len(chunk) / float(rateLimitBytes))
	response.close()
	return {
		'success': True,
		'status': status,
		'content_type': contentType,
		'sha256': hasher.hexdigest(),
	}

def updateRecipe(recipeFile):
	with open(recipeFile, 'r') as f:
		recipe = f.read()

	if 'ARCHITECTURES="' not in recipe:
		return

	recipeFileName = os.path.basename(recipeFile)
	recipeName = recipeFileName.partition('-')[0]

	shellVars.clear()
	shellVars['portName'] = os.path.basename(recipeFile).partition('-')[0]
	shellVars['portVersion'] = os.path.basename(recipeFile).partition('-')[2][:-7]
	shellVars['portVersionedName'] = shellVars['portName'] + '-' + shellVars['portVersion']
	shellVars['portBaseName'] = shellVars['portName'].replace('_', '-')

	for srcUriMatch in re.finditer(r'^(SOURCE_URI(?:_\d+)*)="(.+?)"', recipe, flags=re.DOTALL | re.MULTILINE):
		srcUriKey = srcUriMatch.group(1)
		srcFilenameKey = srcUriKey.replace('SOURCE_URI', 'SOURCE_FILENAME')
		checksumSha256Key = srcUriKey.replace('SOURCE_URI', 'CHECKSUM_SHA256')
		for srcUriSpec in srcUriMatch.group(2).split():
			if not (srcUriSpec.startswith('http') or srcUriSpec.startswith('ftp')):
				return
			srcUri = stripFragment(srcUriSpec)
			srcUri = expandVariables(srcUri, recipe)
			srcFilenameMatch = re.search('^' + srcFilenameKey + '="(.+?)"', recipe,
				flags=re.DOTALL | re.MULTILINE)
			if srcFilenameMatch:
				filename = srcFilenameMatch.group(1)
			elif 'sourceforge.net' in srcUri and srcUri.endswith('download'):
				filename = os.path.basename(os.path.dirname(srcUri))
			else:
				filename = os.path.basename(srcUri)
			filename = expandVariables(filename, recipe)
			borkedMarkerPath = downloadDir + '/' + filename + '.is_borked'
			if os.path.exists(borkedMarkerPath):
				return
			s3target = recipeName + '/' + filename
			downloadpath = downloadDir + '/' + filename
			checksumMatch = re.search('^' + checksumSha256Key + '="(.+?)"', recipe,
				flags=re.DOTALL | re.MULTILINE)
			if checksumMatch and s3ObjectValid(s3target, checksumMatch.group(1)):
				log('info', 'no update needed for ' + filename + ' - checksum matches s3://' + s3Bucket + '/' + s3target,
					filename=filename, bucket=s3Bucket, key=s3target, sha256=checksumMatch.group(1))
				return
			log('info', os.path.basename(recipeFile) + ' => ' + filename + " (" + srcUri + ")",
				recipe=recipeFileName, filename=filename, uri=srcUri)
			if not checksumMatch:
				log('error', 'recipe ' + recipeFile + ' does not contain a usable checksum!')
				return
			if os.path.exists(downloadpath):
				os.remove(downloadpath)
			if srcUri.startswith('http'):
				remoteSize = getRemoteFileSize(srcUri)
				if remoteSize is not None and remoteSize > maxSourceSizeBytes:
					log('info', 'skipping archival of ' + filename + ' - remote source package is larger than maxSourceSizeBytes',
						filename=filename, bytes=remoteSize, size_mib=remoteSize / (1024 * 1024.0), uri=srcUri)
					return
			downloadResult = downloadFile(srcUri, downloadpath, rateLimitBytes=5 * 1024 * 1024)
			if not downloadResult['success']:
				if os.path.exists(downloadpath):
					os.remove(downloadpath)
				log('error', 'unable to download ' + filename + ': ' + downloadResult['error'],
					filename=filename, uri=srcUri, http_code=downloadResult['status'])
				return

			if 'html' in downloadResult['content_type'].lower() or isHttpHtmlResponse(downloadpath):
				os.remove(downloadpath)
				log('error', 'downloaded an HTTP response instead of the source file for ' + filename,
					filename=filename, content_type=downloadResult['content_type'], uri=srcUri)
				return

			checksum = downloadResult['sha256']
			if checksum != checksumMatch.group(1):
				log('error', 'SHA256-checksum mismatch for ' + filename,
					filename=filename, expected=checksumMatch.group(1), got=checksum)
				return

			fileSize = os.path.getsize(downloadpath)
			if fileSize > maxSourceSizeBytes:
				os.remove(downloadpath)
				log('info', 'skipping archival of ' + filename + ' - source package is larger than maxSourceSizeBytes',
					filename=filename, bytes=fileSize, size_mib=fileSize / (1024 * 1024.0))
				return

			try:
				s3Client.upload_file(downloadpath, s3Bucket, s3target,
					ExtraArgs={'Metadata': {'sha256': checksum}})
			except Exception as e:
				os.remove(downloadpath)
				log('error', 'unable to archive ' + filename + ' to s3://' + s3Bucket + '/' + s3target + ': ' + str(e),
					filename=filename, bucket=s3Bucket, key=s3target, error=str(e))
				return
			os.remove(downloadpath)
			log('info', 'archived ' + filename + ' to s3://' + s3Bucket + '/' + s3target,
				filename=filename, bucket=s3Bucket, key=s3target, sha256=checksum)


def updateFromCheckout(gitRepoDir):
	for recipeFile in glob.glob(gitRepoDir + '/*/*/*.recipe'):
		try:
			updateRecipe(recipeFile)
		except OSError as e:
			log('error', 'exception while processing ' + recipeFile + ': ' + str(e),
				recipe_file=recipeFile, error=str(e))
			continue

while True:
	for gitRepo in gitRepos:
		gitRepoDir = gitRepo[0]
		gitRepoUrl = gitRepo[1]
		repoName = gitRepoDir.split('/')[-1]

		if not os.path.exists(gitRepoDir):
			log('info', 'cloning %s from %s' % (repoName, gitRepoUrl),
				repo=repoName, url=gitRepoUrl)
			check_call([ 'git', 'clone', gitRepoUrl, gitRepoDir ])
		check_call([ 'git', 'fetch', '--all' ], cwd=gitRepoDir)

		branchesString = check_output([ 'git', 'branch', '-a' ], cwd=gitRepoDir, universal_newlines=True)
		branches = branchesString.splitlines()

		for branch in branches:
			branch = branch[2:]
			if branch.startswith("(HEAD"):
				continue
			if ' ' in branch:
				branch = branch[0:branch.find(' ')]
			log('info', 'updating %s/%s' % (repoName, branch),
				repo=repoName, branch=branch)
			check_call([ 'git', 'checkout', '-q', branch ], cwd=gitRepoDir)

			updateFromCheckout(gitRepoDir)

	time.sleep(60 * 60 * 6) # 6 hours
